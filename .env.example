# ==========================================
# BAF Risk Monitor - Environment Settings
# All settings have safe local defaults.
# No paid APIs or commercial keys required.
# ==========================================

# Database Path (Default: data/baf_risk_monitor.db)
DATABASE_PATH=data/baf_risk_monitor.db

# Display Timezone (Default: Asia/Manila)
DISPLAY_TIMEZONE=Asia/Manila

# HTTP Request Custom User-Agent
USER_AGENT=BAFRiskMonitor/1.0 (OSINT Research Bot; compliant; +https://github.com/local/baf-risk-monitor)

# Optional Reddit Credentials (Leave blank to use public search endpoints)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
